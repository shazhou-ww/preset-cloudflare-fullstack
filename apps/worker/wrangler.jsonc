{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signal-desk",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_NAME": "Signal Desk",
  },
  "observability": {
    "enabled": true,
  },
}
