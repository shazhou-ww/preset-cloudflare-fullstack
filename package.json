{
  "name": "preset-pnpm-monorepo",
  "version": "0.0.0",
  "description": "A strict TypeScript monorepo preset built with pnpm workspaces and Turborepo.",
  "keywords": [
    "typescript",
    "pnpm",
    "monorepo",
    "turborepo",
    "preset",
    "template"
  ],
  "homepage": "https://github.com/shazhou-ww/preset-pnpm-monorepo#readme",
  "bugs": {
    "url": "https://github.com/shazhou-ww/preset-pnpm-monorepo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/preset-pnpm-monorepo.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint:release && pnpm test:release && turbo run lint typecheck test build",
    "clean": "turbo run clean && node -e \"require('node:fs').rmSync('.turbo', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:release && turbo run lint",
    "lint:release": "eslint scripts",
    "test": "pnpm test:release && turbo run test",
    "test:release": "node --test scripts/*.test.js",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "github-ci-verify": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "semver": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
